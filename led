#!/usr/bin/env bash
set -euo pipefail

APP_NAME="led"
DEFAULT_CONFIG_FILE="/etc/ugreen-led-cli.conf"
CONFIG_FILE="${UGREEN_LED_CONFIG:-$DEFAULT_CONFIG_FILE}"
LOCK_FILE="${UGREEN_LED_LOCK:-/run/ugreen-led-cli.lock}"
DEFAULT_BACKEND="/usr/local/libexec/ugreen_leds_cli"
DEFAULT_LEDS="power netdev disk1 disk2 disk3 disk4"
DEFAULT_MODE="resources"
DEFAULT_BRIGHTNESS=140
DEFAULT_REFRESH_SECONDS=5
DEFAULT_MANUAL_FILE="/var/lib/ugreen-led-cli/manual.tsv"
DEFAULT_TELEMETRY_FILE="/run/ugreen-led-cli/telemetry.env"
DEFAULT_TELEMETRY_TTL_SECONDS=90
SERVICE_NAME="${UGREEN_LED_SERVICE:-ugreen-led-mode.service}"

usage() {
  cat <<'EOF'
Usage:
  led
  led status
  led colors
  led mode
  led mode resources
  led mode solid purple [--brightness 140]
  led mode manual
  led mode off
  led set power red [--brightness 180]
  led set disk1,disk2 '#00ffaa'
  led set all 255,0,255
  led trick rainbow [15s]
  led trick chase [15s] [color]
  led trick pulse [15s|forever] [color]
  led trick police [15s]
  led trick random [15s]
  led trick identify

Persistent modes:
  resources   Unraid array/disk telemetry when fresh; host metrics otherwise.
  solid       One saved color for every configured LED.
  manual      Saved per-LED state created by 'led set'.
  off         Turn every configured LED off.

Temporary tricks restore the previous LED state and service mode on exit,
including Ctrl-C. Durations default to 15 seconds, are capped at 300 seconds,
or may be 'forever' when another process will cancel the alert.
EOF
}

die() {
  printf '%s: %s\n' "$APP_NAME" "$*" >&2
  exit 1
}

warn() {
  printf '%s: warning: %s\n' "$APP_NAME" "$*" >&2
}

validate_uint_range() {
  local label="$1" value="$2" minimum="$3" maximum="$4"
  [[ "$value" =~ ^[0-9]+$ ]] || die "$label must be a number from $minimum to $maximum"
  [ "$value" -ge "$minimum" ] && [ "$value" -le "$maximum" ] ||
    die "$label must be from $minimum to $maximum"
}

validate_mode() {
  case "$1" in
    resources|solid|manual|off) ;;
    *) die "mode must be resources, solid, manual, or off" ;;
  esac
}

validate_leds() {
  local led
  [ -n "$1" ] || die "LEDS cannot be empty"
  for led in $1; do
    [[ "$led" =~ ^[a-zA-Z0-9_-]+$ ]] || die "invalid LED name: $led"
  done
}

validate_interface() {
  [ -z "$1" ] || [[ "$1" =~ ^[a-zA-Z0-9_.:-]+$ ]] || die "invalid network interface: $1"
}

validate_color_components() {
  validate_uint_range "red" "$1" 0 255
  validate_uint_range "green" "$2" 0 255
  validate_uint_range "blue" "$3" 0 255
}

parse_color() {
  local input hex red green blue
  input="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$input" in
    red) echo "255 0 0" ;;
    orange) echo "255 96 0" ;;
    yellow) echo "255 220 0" ;;
    green) echo "0 255 0" ;;
    cyan) echo "0 255 255" ;;
    blue) echo "0 96 255" ;;
    purple) echo "160 32 255" ;;
    magenta) echo "255 0 255" ;;
    pink) echo "255 64 160" ;;
    white) echo "255 255 255" ;;
    warmwhite|warm-white) echo "255 180 96" ;;
    black) echo "0 0 0" ;;
    \#[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])
      hex="${input#\#}"
      red=$((16#${hex:0:2}))
      green=$((16#${hex:2:2}))
      blue=$((16#${hex:4:2}))
      echo "$red $green $blue"
      ;;
    [0-9]*,[0-9]*,[0-9]*)
      IFS=, read -r red green blue <<< "$input"
      validate_color_components "$red" "$green" "$blue"
      echo "$red $green $blue"
      ;;
    *) die "unknown color '$1'; run 'led colors'" ;;
  esac
}

print_colors() {
  cat <<'EOF'
red         255,0,0
orange      255,96,0
yellow      255,220,0
green       0,255,0
cyan        0,255,255
blue        0,96,255
purple      160,32,255
magenta     255,0,255
pink        255,64,160
white       255,255,255
warmwhite   255,180,96
black       0,0,0

Custom colors may use '#RRGGBB' or 'R,G,B'.
EOF
}

load_config() {
  BACKEND="$DEFAULT_BACKEND"
  LEDS="$DEFAULT_LEDS"
  MODE="$DEFAULT_MODE"
  BRIGHTNESS="$DEFAULT_BRIGHTNESS"
  REFRESH_SECONDS="$DEFAULT_REFRESH_SECONDS"
  MANUAL_FILE="$DEFAULT_MANUAL_FILE"
  SOLID_COLOR="160 32 255"
  SOLID_BRIGHTNESS="$DEFAULT_BRIGHTNESS"
  INTERFACE=""
  VM_ID=""
  HEALTH_URL=""
  TEMP_WARN_C=80
  TEMP_CRIT_C=90
  ROOT_PATH="/"
  TELEMETRY_FILE="$DEFAULT_TELEMETRY_FILE"
  TELEMETRY_TTL_SECONDS="$DEFAULT_TELEMETRY_TTL_SECONDS"

  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    . "$CONFIG_FILE"
  fi

  BACKEND="${UGREEN_LED_BACKEND:-$BACKEND}"
  MANUAL_FILE="${UGREEN_LED_MANUAL_FILE:-$MANUAL_FILE}"
  TELEMETRY_FILE="${UGREEN_LED_TELEMETRY_FILE:-$TELEMETRY_FILE}"
  validate_leds "$LEDS"
  validate_mode "$MODE"
  validate_uint_range "brightness" "$BRIGHTNESS" 0 255
  validate_uint_range "solid brightness" "$SOLID_BRIGHTNESS" 0 255
  validate_uint_range "refresh interval" "$REFRESH_SECONDS" 1 3600
  validate_uint_range "temperature warning" "$TEMP_WARN_C" 20 120
  validate_uint_range "temperature critical" "$TEMP_CRIT_C" 20 120
  validate_uint_range "telemetry TTL" "$TELEMETRY_TTL_SECONDS" 10 3600
  [ "$TEMP_CRIT_C" -gt "$TEMP_WARN_C" ] || die "TEMP_CRIT_C must be greater than TEMP_WARN_C"
  validate_interface "$INTERFACE"
  if [ -n "$VM_ID" ]; then
    [[ "$VM_ID" =~ ^[0-9]+$ ]] || die "VM_ID must be numeric"
  fi
  if [ -n "$HEALTH_URL" ]; then
    [[ "$HEALTH_URL" =~ ^https?:// ]] || die "HEALTH_URL must begin with http:// or https://"
  fi
  read -r _solid_r _solid_g _solid_b <<< "$SOLID_COLOR"
  validate_color_components "$_solid_r" "$_solid_g" "$_solid_b"
}

save_config() {
  local directory temporary
  directory="$(dirname "$CONFIG_FILE")"
  mkdir -p "$directory"
  temporary="$(mktemp "$directory/.ugreen-led-cli.conf.XXXXXX")"
  {
    printf '%s\n' '# UGREEN DXP LED CLI config'
    printf 'BACKEND=%q\n' "$BACKEND"
    printf 'LEDS=%q\n' "$LEDS"
    printf 'MODE=%q\n' "$MODE"
    printf 'BRIGHTNESS=%s\n' "$BRIGHTNESS"
    printf 'REFRESH_SECONDS=%s\n' "$REFRESH_SECONDS"
    printf 'MANUAL_FILE=%q\n' "$MANUAL_FILE"
    printf 'SOLID_COLOR=%q\n' "$SOLID_COLOR"
    printf 'SOLID_BRIGHTNESS=%s\n' "$SOLID_BRIGHTNESS"
    printf 'INTERFACE=%q\n' "$INTERFACE"
    printf 'VM_ID=%q\n' "$VM_ID"
    printf 'HEALTH_URL=%q\n' "$HEALTH_URL"
    printf 'TEMP_WARN_C=%s\n' "$TEMP_WARN_C"
    printf 'TEMP_CRIT_C=%s\n' "$TEMP_CRIT_C"
    printf 'ROOT_PATH=%q\n' "$ROOT_PATH"
    printf 'TELEMETRY_FILE=%q\n' "$TELEMETRY_FILE"
    printf 'TELEMETRY_TTL_SECONDS=%s\n' "$TELEMETRY_TTL_SECONDS"
  } > "$temporary"
  chmod 0644 "$temporary"
  mv "$temporary" "$CONFIG_FILE"
}

require_backend() {
  [ -x "$BACKEND" ] || die "backend is missing or not executable: $BACKEND"
}

require_root_for_write() {
  if [ "$(id -u)" -ne 0 ] && [ "${UGREEN_LED_ALLOW_NONROOT:-0}" != "1" ]; then
    die "run as root, for example with sudo"
  fi
}

with_lock() {
  local lock_directory command_status
  lock_directory="$(dirname "$LOCK_FILE")"
  mkdir -p "$lock_directory"
  exec 9>"$LOCK_FILE"
  if command -v flock >/dev/null 2>&1; then
    flock 9
  else
    warn "flock not found; continuing without process lock"
  fi
  if "$@"; then command_status=0; else command_status=$?; fi
  exec 9>&-
  return "$command_status"
}

backend_status() {
  require_backend
  "$BACKEND" all -status
}

backend_set() {
  local target="$1" red="$2" green="$3" blue="$4" brightness="$5"
  "$BACKEND" "$target" -color "$red" "$green" "$blue" -brightness "$brightness" -on >/dev/null
}

backend_off() {
  "$BACKEND" "$1" -off >/dev/null
}

backend_restore() {
  local target="$1" state="$2" brightness="$3" red="$4" green="$5" blue="$6"
  local time_on="${7:-0}" time_off="${8:-0}"
  case "$state" in
    on|off)
      "$BACKEND" "$target" -color "$red" "$green" "$blue" \
        -brightness "$brightness" "-$state" >/dev/null
      ;;
    blink|breath)
      "$BACKEND" "$target" -color "$red" "$green" "$blue" \
        -brightness "$brightness" "-$state" "$time_on" "$time_off" >/dev/null
      ;;
    *) die "cannot restore unknown LED state: $state" ;;
  esac
}

configured_led() {
  local wanted="$1" led
  for led in $LEDS; do
    [ "$led" = "$wanted" ] && return 0
  done
  return 1
}

expand_targets() {
  local input="$1" target output=""
  if [ "$input" = "all" ]; then
    echo "$LEDS"
    return
  fi
  input="${input//,/ }"
  for target in $input; do
    configured_led "$target" || die "unknown LED '$target'; configured LEDs: $LEDS"
    output="${output:+$output }$target"
  done
  [ -n "$output" ] || die "no LED targets supplied"
  echo "$output"
}

capture_snapshot() {
  local output_file="$1" line led
  : > "$output_file"
  while IFS= read -r line; do
    if [[ "$line" =~ ^([a-zA-Z0-9_-]+):[[:space:]]status[[:space:]]=[[:space:]](on|off|blink|breath),[[:space:]]brightness[[:space:]]=[[:space:]]([0-9]+),[[:space:]]color[[:space:]]=[[:space:]]RGB\(([0-9]+),[[:space:]]*([0-9]+),[[:space:]]*([0-9]+)\)(,[[:space:]](blink_on|breath_on)[[:space:]]=[[:space:]]([0-9]+)[[:space:]]ms,[[:space:]](blink_off|breath_off)[[:space:]]=[[:space:]]([0-9]+)[[:space:]]ms)?$ ]]; then
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" \
        "${BASH_REMATCH[4]}" "${BASH_REMATCH[5]}" "${BASH_REMATCH[6]}" \
        "${BASH_REMATCH[9]:-0}" "${BASH_REMATCH[11]:-0}" >> "$output_file"
    fi
  done < <(backend_status)

  for led in $LEDS; do
    awk -F '\t' -v wanted="$led" '$1 == wanted { found=1 } END { exit !found }' "$output_file" ||
      die "backend status did not contain a restorable state for $led"
  done
}

restore_snapshot() {
  local input_file="$1" led state brightness red green blue time_on time_off
  while IFS=$'\t' read -r led state brightness red green blue time_on time_off; do
    configured_led "$led" || continue
    backend_restore "$led" "$state" "$brightness" "$red" "$green" "$blue" "$time_on" "$time_off"
  done < "$input_file"
}

apply_solid() {
  local red green blue led
  read -r red green blue <<< "$SOLID_COLOR"
  for led in $LEDS; do
    backend_set "$led" "$red" "$green" "$blue" "$SOLID_BRIGHTNESS"
  done
}

apply_off() {
  local led
  for led in $LEDS; do
    backend_off "$led"
  done
}

apply_manual() {
  [ -s "$MANUAL_FILE" ] || die "manual state does not exist; run 'led set' first"
  restore_snapshot "$MANUAL_FILE"
}

metric_color() {
  local value="$1"
  if (( value >= 90 )); then
    echo "255 0 0"
  elif (( value >= 75 )); then
    echo "255 96 0"
  elif (( value >= 50 )); then
    echo "255 200 0"
  else
    echo "0 255 0"
  fi
}

load_telemetry() {
  local key value now age slot
  TELEMETRY_STATE=absent
  [ -f "$TELEMETRY_FILE" ] || return 1
  UGREEN_TELEMETRY_RECEIVED_AT=""
  UGREEN_TELEMETRY_ARRAY_STATE=UNKNOWN
  UGREEN_TELEMETRY_ARRAY_HEALTH=UNKNOWN
  UGREEN_TELEMETRY_ARRAY_USAGE_PCT=""
  for slot in 1 2 3 4; do
    printf -v "UGREEN_TELEMETRY_DISK${slot}_PRESENT" '%s' 0
    printf -v "UGREEN_TELEMETRY_DISK${slot}_TEMP_C" '%s' ""
    printf -v "UGREEN_TELEMETRY_DISK${slot}_STATUS" '%s' MISSING
    printf -v "UGREEN_TELEMETRY_DISK${slot}_USAGE_PCT" '%s' ""
  done
  while IFS='=' read -r key value; do
    case "$key" in
      UGREEN_TELEMETRY_RECEIVED_AT|UGREEN_TELEMETRY_ARRAY_STATE|UGREEN_TELEMETRY_ARRAY_HEALTH|UGREEN_TELEMETRY_ARRAY_USAGE_PCT|UGREEN_TELEMETRY_DISK[1-4]_PRESENT|UGREEN_TELEMETRY_DISK[1-4]_TEMP_C|UGREEN_TELEMETRY_DISK[1-4]_STATUS|UGREEN_TELEMETRY_DISK[1-4]_USAGE_PCT)
        printf -v "$key" '%s' "$value"
        ;;
    esac
  done < "$TELEMETRY_FILE"
  if ! [[ "$UGREEN_TELEMETRY_RECEIVED_AT" =~ ^[0-9]+$ ]]; then
    TELEMETRY_STATE=stale
    return 2
  fi
  now="$(date +%s)"
  age=$((now - UGREEN_TELEMETRY_RECEIVED_AT))
  if [ "$age" -lt 0 ] || [ "$age" -gt "$TELEMETRY_TTL_SECONDS" ]; then
    TELEMETRY_STATE=stale
    return 2
  fi
  TELEMETRY_STATE=fresh
  TELEMETRY_AGE_SECONDS="$age"
  return 0
}

telemetry_temperature_color() {
  local temperature="$1" status="$2" present="$3"
  if [ "$present" != "1" ] || [ "$status" = "FAILED" ] || [ "$status" = "MISSING" ]; then
    echo "255 0 0"
  elif [[ "$temperature" =~ ^[0-9]+$ ]] && (( temperature >= 50 )); then
    echo "255 0 0"
  elif [ "$status" = "WARNING" ]; then
    echo "255 96 0"
  elif [ "$status" = "UNKNOWN" ]; then
    echo "160 32 255"
  elif ! [[ "$temperature" =~ ^[0-9]+$ ]]; then
    echo "0 255 255"
  elif (( temperature >= 45 )); then
    echo "255 96 0"
  elif (( temperature >= 40 )); then
    echo "255 220 0"
  elif (( temperature >= 30 )); then
    echo "0 255 0"
  else
    echo "0 96 255"
  fi
}

telemetry_brightness() {
  local usage="$1"
  if [[ "$usage" =~ ^[0-9]+$ ]] && [ "$usage" -le 100 ]; then
    echo "$((100 + usage * 155 / 100))"
  else
    echo "$BRIGHTNESS"
  fi
}

apply_telemetry_disks() {
  local slot led present_var temp_var status_var usage_var present temperature status usage
  local red green blue brightness
  for slot in 1 2 3 4; do
    led="disk$slot"
    present_var="UGREEN_TELEMETRY_DISK${slot}_PRESENT"
    temp_var="UGREEN_TELEMETRY_DISK${slot}_TEMP_C"
    status_var="UGREEN_TELEMETRY_DISK${slot}_STATUS"
    usage_var="UGREEN_TELEMETRY_DISK${slot}_USAGE_PCT"
    present="${!present_var}" temperature="${!temp_var}"
    status="${!status_var}" usage="${!usage_var:-$UGREEN_TELEMETRY_ARRAY_USAGE_PCT}"
    read -r red green blue <<< "$(telemetry_temperature_color "$temperature" "$status" "$present")"
    brightness="$(telemetry_brightness "$usage")"
    resource_set_led "$led" "$red" "$green" "$blue" "$brightness"
  done
}

cpu_sample() {
  local label user nice system idle iowait irq softirq steal guest guest_nice
  read -r label user nice system idle iowait irq softirq steal guest guest_nice < /proc/stat
  echo "$((user + nice + system + idle + iowait + irq + softirq + steal)) $((idle + iowait)) $iowait"
}

memory_percent() {
  local total available
  total="$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)"
  available="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
  echo "$(((total - available) * 100 / total))"
}

root_percent() {
  df -P "$ROOT_PATH" | awk 'NR == 2 {gsub(/%/, "", $5); print $5}'
}

package_temperature() {
  local hwmon label_file input_file
  for hwmon in /sys/class/hwmon/hwmon*; do
    [ -r "$hwmon/name" ] || continue
    [ "$(cat "$hwmon/name")" = "coretemp" ] || continue
    for label_file in "$hwmon"/temp*_label; do
      [ -r "$label_file" ] || continue
      [ "$(cat "$label_file")" = "Package id 0" ] || continue
      input_file="${label_file%_label}_input"
      [ -r "$input_file" ] && echo "$(($(cat "$input_file") / 1000))" && return
    done
  done
  echo 0
}

health_ok() {
  if [ -n "${UGREEN_LED_TEST_HEALTH:-}" ]; then
    [ "$UGREEN_LED_TEST_HEALTH" = "1" ]
    return
  fi
  if [ -n "$VM_ID" ]; then
    command -v qm >/dev/null 2>&1 || return 1
    qm status "$VM_ID" 2>/dev/null | grep -q 'status: running' || return 1
  fi
  if [ -n "$HEALTH_URL" ]; then
    command -v curl >/dev/null 2>&1 || return 1
    curl -kfsS -o /dev/null --connect-timeout 2 --max-time 4 "$HEALTH_URL" || return 1
  fi
  return 0
}

gateway_ok() {
  if [ -n "${UGREEN_LED_TEST_GATEWAY:-}" ]; then
    [ "$UGREEN_LED_TEST_GATEWAY" = "1" ]
    return
  fi
  local gateway
  gateway="$(ip route show default | awk 'NR == 1 {print $3}')"
  [ -n "$gateway" ] && ping -q -c 1 -W 1 "$gateway" >/dev/null
}

network_speed() {
  if [ -n "${UGREEN_LED_TEST_NETWORK_SPEED:-}" ]; then
    echo "$UGREEN_LED_TEST_NETWORK_SPEED"
    return
  fi
  if [ -n "$INTERFACE" ] && [ -r "/sys/class/net/$INTERFACE/speed" ]; then
    cat "/sys/class/net/$INTERFACE/speed" 2>/dev/null || echo 0
  else
    echo 0
  fi
}

network_color() {
  case "$1" in
    100) echo "0 255 0" ;;
    1000) echo "0 96 255" ;;
    2500) echo "255 255 0" ;;
    10000) echo "255 255 255" ;;
    *) echo "255 165 0" ;;
  esac
}

resource_set_led() {
  local led="$1" red="$2" green="$3" blue="$4" brightness="$5"
  local state="$red $green $blue $brightness" state_var current_state
  configured_led "$led" || return
  state_var="RESOURCE_STATE_${led//-/_}"
  current_state="${!state_var:-}"
  [ "$current_state" = "$state" ] && return
  backend_set "$led" "$red" "$green" "$blue" "$brightness"
  printf -v "$state_var" '%s' "$state"
}

apply_resource_values() {
  local cpu="$1" memory="$2" iowait="$3" root="$4" temperature="$5" speed="$6" telemetry_state="$7"
  local red green blue

  if ! health_ok || (( temperature >= TEMP_CRIT_C )) ||
    { [ "$telemetry_state" = fresh ] && { [ "$UGREEN_TELEMETRY_ARRAY_STATE" != STARTED ] || [[ "$UGREEN_TELEMETRY_ARRAY_HEALTH" =~ ^(FAULTED|OFFLINE)$ ]]; }; }; then
    resource_set_led power 255 0 0 255
  elif [ "$telemetry_state" = stale ] ||
    { [ "$telemetry_state" = fresh ] && [[ "$UGREEN_TELEMETRY_ARRAY_HEALTH" =~ ^(DEGRADED|UNKNOWN)$ ]]; } ||
    (( temperature >= TEMP_WARN_C )); then
    resource_set_led power 255 96 0 220
  else
    resource_set_led power 0 255 0 160
  fi

  if gateway_ok; then
    read -r red green blue <<< "$(network_color "$speed")"
    resource_set_led netdev "$red" "$green" "$blue" 160
  else
    resource_set_led netdev 255 0 0 255
  fi

  if [ "$telemetry_state" = fresh ]; then
    apply_telemetry_disks
  elif [ "$telemetry_state" = stale ]; then
    for led in disk1 disk2 disk3 disk4; do
      resource_set_led "$led" 0 96 255 60
    done
  else
    read -r red green blue <<< "$(metric_color "$cpu")"
    resource_set_led disk1 "$red" "$green" "$blue" "$BRIGHTNESS"
    read -r red green blue <<< "$(metric_color "$memory")"
    resource_set_led disk2 "$red" "$green" "$blue" "$BRIGHTNESS"
    read -r red green blue <<< "$(metric_color "$iowait")"
    resource_set_led disk3 "$red" "$green" "$blue" "$BRIGHTNESS"
    read -r red green blue <<< "$(metric_color "$root")"
    resource_set_led disk4 "$red" "$green" "$blue" "$BRIGHTNESS"
  fi
}

run_resources() {
  local previous_total previous_idle previous_iowait current_total current_idle current_iowait
  local total_delta idle_delta iowait_delta cpu_percent iowait_percent memory_usage root_usage temperature speed telemetry_state

  if [ -n "${UGREEN_LED_TEST_CPU_PCT:-}" ] && [ -n "${UGREEN_LED_TEST_IOWAIT_PCT:-}" ]; then
    previous_total=0 previous_idle=0 previous_iowait=0
  else
    read -r previous_total previous_idle previous_iowait <<< "$(cpu_sample)"
  fi

  while true; do
    if [ -z "${UGREEN_LED_TEST_CPU_PCT:-}" ] || [ -z "${UGREEN_LED_TEST_IOWAIT_PCT:-}" ]; then
      sleep 1
      read -r current_total current_idle current_iowait <<< "$(cpu_sample)"
      total_delta=$((current_total - previous_total))
      idle_delta=$((current_idle - previous_idle))
      iowait_delta=$((current_iowait - previous_iowait))
      if (( total_delta > 0 )); then
        cpu_percent=$(((total_delta - idle_delta) * 100 / total_delta))
        iowait_percent=$((iowait_delta * 100 / total_delta))
      else
        cpu_percent=0 iowait_percent=0
      fi
      previous_total="$current_total"
      previous_idle="$current_idle"
      previous_iowait="$current_iowait"
    fi

    cpu_percent="${UGREEN_LED_TEST_CPU_PCT:-$cpu_percent}"
    iowait_percent="${UGREEN_LED_TEST_IOWAIT_PCT:-$iowait_percent}"
    memory_usage="${UGREEN_LED_TEST_MEMORY_PCT:-$(memory_percent)}"
    root_usage="${UGREEN_LED_TEST_ROOT_PCT:-$(root_percent)}"
    temperature="${UGREEN_LED_TEST_TEMP_C:-$(package_temperature)}"
    speed="$(network_speed)"
    if load_telemetry; then
      telemetry_state=fresh
    elif [ "$TELEMETRY_STATE" = stale ]; then
      telemetry_state=stale
    else
      telemetry_state=absent
    fi
    apply_resource_values "$cpu_percent" "$memory_usage" "$iowait_percent" "$root_usage" "$temperature" "$speed" "$telemetry_state"

    [ "${UGREEN_LED_ONCE:-0}" = "1" ] && break
    sleep "$REFRESH_SECONDS"
  done
}

apply_saved_mode_once() {
  case "$MODE" in
    resources) UGREEN_LED_ONCE=1 run_resources ;;
    solid) apply_solid ;;
    manual) apply_manual ;;
    off) apply_off ;;
  esac
}

run_daemon() {
  require_root_for_write
  require_backend
  case "$MODE" in
    resources)
      with_lock run_resources
      ;;
    solid|manual|off)
      with_lock apply_saved_mode_once
      [ "${UGREEN_LED_ONCE:-0}" = "1" ] && return
      while true; do sleep 3600; done
      ;;
  esac
}

service_active() {
  [ "${UGREEN_LED_SKIP_SYSTEMD:-0}" != "1" ] && command -v systemctl >/dev/null 2>&1 &&
    systemctl is-active --quiet "$SERVICE_NAME"
}

apply_or_restart_service() {
  if [ "${UGREEN_LED_SKIP_SYSTEMD:-0}" = "1" ] || ! command -v systemctl >/dev/null 2>&1; then
    with_lock apply_saved_mode_once
  else
    systemctl restart "$SERVICE_NAME"
  fi
}

show_status() {
  local service_state
  printf 'mode: %s\n' "$MODE"
  printf 'config: %s\n' "$CONFIG_FILE"
  printf 'backend: %s\n' "$BACKEND"
  printf 'leds: %s\n' "$LEDS"
  if command -v systemctl >/dev/null 2>&1; then
    service_state="$(systemctl is-active "$SERVICE_NAME" 2>/dev/null || true)"
    printf 'service: %s\n' "${service_state:-unavailable}"
  else
    printf 'service: unavailable\n'
  fi
  printf '\n'
  backend_status
}

set_mode() {
  local requested="${1:-}" color="" brightness="$BRIGHTNESS"
  [ -n "$requested" ] || { echo "$MODE"; return; }
  shift

  case "$requested" in
    resources|off)
      MODE="$requested"
      ;;
    manual)
      [ -s "$MANUAL_FILE" ] || die "manual state does not exist; run 'led set' first"
      MODE=manual
      ;;
    solid)
      color="${1:-}"
      [ -n "$color" ] || die "usage: led mode solid <color> [--brightness 0-255]"
      shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --brightness)
            [ "$#" -ge 2 ] || die "--brightness requires a value"
            brightness="$2"
            shift 2
            ;;
          *) die "unknown solid-mode option: $1" ;;
        esac
      done
      validate_uint_range "brightness" "$brightness" 0 255
      SOLID_COLOR="$(parse_color "$color")"
      SOLID_BRIGHTNESS="$brightness"
      MODE=solid
      ;;
    *) die "unknown mode: $requested" ;;
  esac

  require_root_for_write
  save_config
  apply_or_restart_service
  show_status
}

update_manual_snapshot() {
  local targets="$1" red="$2" green="$3" blue="$4" brightness="$5"
  local directory temporary
  directory="$(dirname "$MANUAL_FILE")"
  mkdir -p "$directory"
  temporary="$(mktemp "$directory/.manual.XXXXXX")"
  awk -F '\t' -v OFS='\t' -v targets=" $targets " -v r="$red" -v g="$green" -v b="$blue" -v bright="$brightness" '
    index(targets, " " $1 " ") { $2 = "on"; $3 = bright; $4 = r; $5 = g; $6 = b; $7 = 0; $8 = 0 }
    { print }
  ' "$MANUAL_FILE" > "$temporary"
  chmod 0644 "$temporary"
  mv "$temporary" "$MANUAL_FILE"
}

set_manual_leds() {
  local target_arg="${1:-}" color="${2:-}" brightness="$BRIGHTNESS"
  local targets red green blue was_active=0
  [ -n "$target_arg" ] && [ -n "$color" ] || die "usage: led set <target[,target]|all> <color> [--brightness 0-255]"
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --brightness)
        [ "$#" -ge 2 ] || die "--brightness requires a value"
        brightness="$2"
        shift 2
        ;;
      *) die "unknown set option: $1" ;;
    esac
  done
  validate_uint_range "brightness" "$brightness" 0 255
  targets="$(expand_targets "$target_arg")"
  read -r red green blue <<< "$(parse_color "$color")"
  require_root_for_write
  require_backend

  service_active && was_active=1
  [ "$was_active" -eq 0 ] || systemctl stop "$SERVICE_NAME"
  mkdir -p "$(dirname "$MANUAL_FILE")"
  with_lock capture_snapshot "$MANUAL_FILE"
  update_manual_snapshot "$targets" "$red" "$green" "$blue" "$brightness"
  MODE=manual
  save_config
  apply_or_restart_service
  show_status
}

parse_duration() {
  local input="${1:-15}"
  if [ "$input" = "forever" ]; then
    echo 0
    return
  fi
  input="${input%s}"
  validate_uint_range "trick duration" "$input" 1 300
  echo "$input"
}

trick_continue() {
  local start="$1" duration="$2" step="$3"
  if [ -n "${UGREEN_LED_TRICK_STEPS:-}" ]; then
    [ "$step" -lt "$UGREEN_LED_TRICK_STEPS" ]
  elif [ "$duration" -eq 0 ]; then
    return 0
  else
    [ "$(( $(date +%s) - start ))" -lt "$duration" ]
  fi
}

trick_sleep() {
  [ "${UGREEN_LED_TEST_NO_SLEEP:-0}" = "1" ] || sleep "$1"
}

effect_rainbow() {
  local duration="$1" start step=0 offset=0 led index color red green blue
  local palette=("255 0 0" "255 96 0" "255 220 0" "0 255 0" "0 255 255" "0 96 255" "160 32 255" "255 0 255")
  start="$(date +%s)"
  while trick_continue "$start" "$duration" "$step"; do
    index=0
    for led in $LEDS; do
      color="${palette[$(((index + offset) % ${#palette[@]}))]}"
      read -r red green blue <<< "$color"
      backend_set "$led" "$red" "$green" "$blue" 180
      index=$((index + 1))
    done
    offset=$((offset + 1)) step=$((step + 1))
    trick_sleep 0.25
  done
}

effect_chase() {
  local duration="$1" color="$2" start step=0 index=0 led red green blue current=0
  read -r red green blue <<< "$(parse_color "$color")"
  start="$(date +%s)"
  while trick_continue "$start" "$duration" "$step"; do
    index=0
    for led in $LEDS; do
      if [ "$index" -eq "$current" ]; then
        backend_set "$led" "$red" "$green" "$blue" 220
      else
        backend_set "$led" 0 0 0 12
      fi
      index=$((index + 1))
    done
    current=$(((current + 1) % $(wc -w <<< "$LEDS"))) step=$((step + 1))
    trick_sleep 0.18
  done
}

effect_pulse() {
  local duration="$1" color="$2" start step=0 brightness led red green blue
  local levels=(20 50 100 170 240 170 100 50)
  read -r red green blue <<< "$(parse_color "$color")"
  start="$(date +%s)"
  while trick_continue "$start" "$duration" "$step"; do
    brightness="${levels[$((step % ${#levels[@]}))]}"
    for led in $LEDS; do backend_set "$led" "$red" "$green" "$blue" "$brightness"; done
    step=$((step + 1))
    trick_sleep 0.16
  done
}

effect_police() {
  local duration="$1" start step=0 index led
  start="$(date +%s)"
  while trick_continue "$start" "$duration" "$step"; do
    index=0
    for led in $LEDS; do
      if [ $(((index + step) % 2)) -eq 0 ]; then
        backend_set "$led" 255 0 0 230
      else
        backend_set "$led" 0 64 255 230
      fi
      index=$((index + 1))
    done
    step=$((step + 1))
    trick_sleep 0.22
  done
}

effect_random() {
  local duration="$1" start step=0 led
  start="$(date +%s)"
  while trick_continue "$start" "$duration" "$step"; do
    for led in $LEDS; do backend_set "$led" "$((RANDOM % 256))" "$((RANDOM % 256))" "$((RANDOM % 256))" 180; done
    step=$((step + 1))
    trick_sleep 0.3
  done
}

effect_identify() {
  local led other
  for led in $LEDS; do
    printf '%s\n' "$led"
    for other in $LEDS; do
      if [ "$other" = "$led" ]; then backend_set "$other" 255 255 255 220; else backend_off "$other"; fi
    done
    trick_sleep 1
  done
}

run_effect() {
  local effect="$1" duration="$2" color="$3"
  case "$effect" in
    rainbow) effect_rainbow "$duration" ;;
    chase) effect_chase "$duration" "$color" ;;
    pulse) effect_pulse "$duration" "$color" ;;
    police) effect_police "$duration" ;;
    random) effect_random "$duration" ;;
    identify) effect_identify ;;
    *) die "unknown trick '$effect'; use rainbow, chase, pulse, police, random, or identify" ;;
  esac
}

run_temporary_trick() {
  local effect="${1:-}" duration_arg="${2:-15s}" color="${3:-purple}"
  local duration snapshot was_active=0 restored=0 snapshot_ready=0
  [ -n "$effect" ] || die "usage: led trick <rainbow|chase|pulse|police|random|identify> [duration] [color]"
  if [ "$effect" = "identify" ]; then duration=1; else duration="$(parse_duration "$duration_arg")"; fi
  require_root_for_write
  require_backend
  snapshot="$(mktemp /tmp/ugreen-led-snapshot.XXXXXX)"
  service_active && was_active=1

  restore_trick() {
    [ "$restored" -eq 0 ] || return
    restored=1
    [ "$snapshot_ready" -eq 0 ] || restore_snapshot "$snapshot" || true
    rm -f "$snapshot"
    if [ "$was_active" -eq 1 ]; then systemctl start "$SERVICE_NAME" || true; fi
  }
  abort_trick() {
    restore_trick
    trap - EXIT INT TERM
    exit 130
  }
  trap restore_trick EXIT
  trap abort_trick INT TERM
  [ "$was_active" -eq 0 ] || systemctl stop "$SERVICE_NAME"
  with_lock capture_snapshot "$snapshot"
  snapshot_ready=1
  with_lock run_effect "$effect" "$duration" "$color"
  restore_trick
  trap - EXIT INT TERM
}

main() {
  local command="${1:-status}"
  shift || true
  load_config

  case "$command" in
    -h|--help|help) usage ;;
    status|"") show_status ;;
    colors) print_colors ;;
    mode) set_mode "$@" ;;
    resources|off) set_mode "$command" ;;
    solid) set_mode solid "$@" ;;
    set) set_manual_leds "$@" ;;
    trick) run_temporary_trick "$@" ;;
    identify) run_temporary_trick identify ;;
    daemon) run_daemon ;;
    *) die "unknown command: $command; run 'led --help'" ;;
  esac
}

main "$@"
